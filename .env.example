# Nearby: every environment variable, with placeholder values only (spec 3.13). No real credential is ever committed.
# PayPal runs in the sandbox only: the app refuses to start unless PAYPAL_BASE_URL is the sandbox URL below.
DATABASE_URL=postgres://user:password@localhost:5432/nearby
APP_BASE_URL=http://localhost:3000
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=your-claude-model-id
AGENT_DISABLED=false
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GOOGLE_MAPS_SERVER_KEY=your-places-api-key-restricted-to-places
GOOGLE_MAPS_BROWSER_KEY=your-maps-javascript-key-restricted-to-your-domain
APP_REPO_URL=https://github.com/your-account/nearby
# Nearby Passes (NEAR testnet only). Unset NEAR_NETWORK: passes are off. scripts/near/setup-testnet.sh writes these
# to .env.near (git-ignored). The app refuses to start if any of them names anything but testnet.
# NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_TX_URL=https://testnet.near.rocks/tx/{hash}
NEAR_EXPLORER_ACCOUNT_URL=https://testnet.near.rocks/account/{account}
NEAR_PASSES_CONTRACT_ID=contract.your-parent.testnet
NEAR_AGENT_ACCOUNT_ID=agent.your-parent.testnet
NEAR_AGENT_PRIVATE_KEY=ed25519:your-agent-function-call-key
NEAR_MERCHANT_ACCOUNTS_JSON={"00000000-0000-4000-8000-000000000001":"saguaro-bean.your-parent.testnet"}
NEAR_MERCHANT_KEYS_JSON={"saguaro-bean.your-parent.testnet":"ed25519:your-merchant-key"}
NEAR_DEMO_ACCOUNT_SECRET=your-32-random-bytes-as-64-hex-characters
PASS_STORAGE_ESTIMATE_NEAR=0.03
NEAR_MERCHANT_FLOOR_NEAR=1
NEAR_AGENT_FLOOR_NEAR=0.5
